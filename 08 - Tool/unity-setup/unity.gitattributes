# .gitattributes per il progetto Unity di Cadaver Animatum
# Destinazione: radice del progetto Unity, con nome ".gitattributes"
#
# Fa due cose:
#   1) dice a Git di fondere scene e prefab con UnityYAMLMerge invece di rovinarli
#   2) manda i file binari su Git LFS, cosi' il repo non cresce senza limite
#
# ATTENZIONE: LFS va configurato PRIMA di committare i binari.
# Convertire dopo richiede di riscrivere la storia del repository.

* text=auto

# ---------------------------------------------------------------- YAML di Unity
# eol=lf: Unity scrive LF. Senza questo, su Windows Git normalizzerebbe a CRLF
# e ogni file risulterebbe modificato senza motivo.
*.unity            merge=unityyamlmerge eol=lf
*.prefab           merge=unityyamlmerge eol=lf
*.asset            merge=unityyamlmerge eol=lf
*.meta             merge=unityyamlmerge eol=lf
*.mat              merge=unityyamlmerge eol=lf
*.anim             merge=unityyamlmerge eol=lf
*.controller       merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial   merge=unityyamlmerge eol=lf
*.mask             merge=unityyamlmerge eol=lf
*.playable         merge=unityyamlmerge eol=lf
*.terrainlayer     merge=unityyamlmerge eol=lf
*.signal           merge=unityyamlmerge eol=lf
*.brush            merge=unityyamlmerge eol=lf
*.mixer            merge=unityyamlmerge eol=lf
*.shadervariants   merge=unityyamlmerge eol=lf
*.lighting         merge=unityyamlmerge eol=lf
*.preset           merge=unityyamlmerge eol=lf
*.inputactions     merge=unityyamlmerge eol=lf

# ---------------------------------------------------------------- codice e testo
*.cs               text diff=csharp
*.shader           text
*.shadergraph      text
*.hlsl             text
*.cginc            text
*.json             text
*.md               text
*.txt              text
*.xml              text
*.yml              text
*.asmdef           text
*.asmref           text

# ---------------------------------------------------------------- immagini -> LFS
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
